# AI Playwright MCP - 环境变量配置
# 请将下方替换为你自己的 OpenAI API Key

# OpenAI API 密钥
OPENAI_API_KEY=key

# OpenAI API 地址（支持兼容 OpenAI 接口的模型服务，如 DeepSeek、通义千问等）
# 默认：https://api.openai.com/v1
# DeepSeek 示例：https://api.deepseek.com/v1
# 通义千问 示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 本地示例：http://localhost:11434/v1
OPENAI_API_BASE=http://172.22.176.1:1234/v1

# 模型名称
# OpenAI: gpt-4o, gpt-4, gpt-3.5-turbo
# DeepSeek: deepseek-chat
# 通义千问: qwen-plus, qwen-max
# Ollama: llama3, qwen2.5 等
OPENAI_MODEL=google/gemma-4-26b-a4b
